{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "ignorePatterns": ["dist/*"],
  "globals": {
    "QRCode": "readonly",
    "qrcode": "readonly",
    "lucide": "readonly",
    "jQuery": "readonly",
    "$": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn"
  }
}
